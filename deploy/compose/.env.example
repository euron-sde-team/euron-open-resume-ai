# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
# `make env` writes the four secrets below; everything else here is optional.
RESUME_JWT_SECRET=replace-with-output-of-make-env
RESUME_REFRESH_SECRET=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
RESUME_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password.
RESUME_DEMO_PASSWORD=replace-with-output-of-make-env

# AI. With no key at all every task (analysis, improvement, cover letter, interview
# questions, roadmap) runs on the built-in offline engine: heuristic and deterministic.
# `make demo` also registers the "Stub" provider (apps/stubs), which needs no key. Real
# providers are managed by an admin in the app (/admin, providers and models); their
# API keys come from here, never from the database. Either one JSON object keyed by
# provider slug ...
# PROVIDER_KEYS={"openai":"sk-...","anthropic":"sk-ant-...","openrouter":"sk-or-..."}
# ... or the single-key shortcuts (PROVIDER_KEYS wins when both name a provider):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# Where the demo's Stub provider lives (inside the compose network):
# STUBS_URL=http://stubs:5199

# Optional tuning (these are the defaults)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=12
# REQUIRE_EMAIL_VERIFICATION=true
# RATE_LIMITS=on
# SIGNED_URL_TTL_SECONDS=900
# DB_POOL_MAX=10
# SMTP_USER=
# SMTP_PASS=
# PDF renderer (headless Chromium, installed in the image; the compose file sets the path)
# PDF_CONCURRENCY=2
# PDF_RECYCLE_PAGES=100
# TEMPLATES_DIR=/app/dist/templates

# Optional overrides (host ports and names)
# RESUME_PRODUCT_NAME=Euron Open Resume AI
# RESUME_LOG_LEVEL=info
# RESUME_WEB_PORT=3630
# RESUME_API_PORT=5106
# RESUME_PG_PORT=5552
# RESUME_REDIS_PORT=6489
# RESUME_MAILPIT_PORT=8106
# RESUME_SMTP_PORT=1106
# RESUME_FLOCI_PORT=4657
# RESUME_STUB_PORT=5199
